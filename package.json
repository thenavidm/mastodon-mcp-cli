{
  "name": "@thenavidm/mastodon-mcp-cli",
  "version": "2.0.1",
  "description": "Mastodon MCP server and CLI for Claude Code and AI agents. 76 tools for posting, editing, threads, timelines, search, lists, notifications and following, across any instance.",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "mastodon-mcp": "dist/index.js",
    "mastodon-cli": "dist/index.js",
    "mastodon-mcp-cli": "dist/npx.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "build:mcpb": "bash desktop-extension/build.sh"
  },
  "dependencies": {
    "@thenavidm/slipway": "^0.1.17",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "ajv": "^8.20.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "license": "MIT",
  "author": "Navid Moazzez (https://navid.me)",
  "homepage": "https://navid.me",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thenavidm/mastodon-mcp-cli.git"
  },
  "bugs": {
    "url": "https://github.com/thenavidm/mastodon-mcp-cli/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mastodon",
    "fediverse",
    "activitypub",
    "mcp-server",
    "claude",
    "claude-code",
    "ai-agents",
    "llm-tools",
    "cli",
    "social-media",
    "codex",
    "toot",
    "slipway"
  ],
  "files": [
    "dist",
    "README.md",
    "SKILL.md",
    "LICENSE"
  ],
  "contributors": [
    "Navid Moazzez (https://navid.me)"
  ]
